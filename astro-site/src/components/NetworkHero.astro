---
// A small stochastic block model drawn live: three clusters, dense within,
// sparse between. Edge opacity pulses like a posterior inclusion probability.
---

<figure class="network">
  <canvas aria-hidden="true"></canvas>
</figure>

<script>
  type Node = { hx: number; hy: number; x: number; y: number; k: number; ph: number; r: number };
  type Edge = { a: number; b: number; w: number; ph: number };

  function rng(seed: number) {
    return () => {
      seed = (seed * 1664525 + 1013904223) % 4294967296;
      return seed / 4294967296;
    };
  }

  function init(fig: HTMLElement) {
    const canvas = fig.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rand = rng(7);

    const centers = [
      { x: 0.3, y: 0.32 },
      { x: 0.74, y: 0.36 },
      { x: 0.5, y: 0.76 },
    ];
    const sizes = [9, 8, 8];
    const nodes: Node[] = [];
    sizes.forEach((n, k) => {
      for (let i = 0; i < n; i++) {
        const a = rand() * Math.PI * 2;
        const d = 0.06 + rand() * 0.13;
        const hx = centers[k].x + Math.cos(a) * d;
        const hy = centers[k].y + Math.sin(a) * d * 1.1;
        nodes.push({ hx, hy, x: hx, y: hy, k, ph: rand() * 6.28, r: 3 + rand() * 3.5 });
      }
    });

    const edges: Edge[] = [];
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const p = nodes[i].k === nodes[j].k ? 0.5 : 0.035;
        if (rand() < p) edges.push({ a: i, b: j, w: 0.35 + rand() * 0.65, ph: rand() * 6.28 });
      }
    }
    const neighbors = nodes.map((_, i) =>
      edges.filter((e) => e.a === i || e.b === i).map((e) => (e.a === i ? e.b : e.a)),
    );

    let colors = { ink: '#000', accent: '#2d6a4f', muted: '#888' };
    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      colors = {
        ink: s.getPropertyValue('--node').trim(),
        accent: s.getPropertyValue('--accent').trim(),
        muted: s.getPropertyValue('--faint').trim(),
      };
    };
    readColors();
    window.addEventListener('themechange', () => {
      readColors();
      if (reduce) draw(0);
    });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      readColors();
      if (reduce) draw(0);
    });

    let w = 0;
    let h = 0;
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (reduce) draw(0);
    };
    new ResizeObserver(resize).observe(canvas);

    let hover = -1;
    const pick = (ev: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      const mx = ev.clientX - r.left;
      const my = ev.clientY - r.top;
      let best = -1;
      let bd = 40 * 40;
      nodes.forEach((n, i) => {
        const d = (n.x * w - mx) ** 2 + (n.y * h - my) ** 2;
        if (d < bd) {
          bd = d;
          best = i;
        }
      });
      hover = best;
      canvas.style.cursor = best >= 0 ? 'pointer' : 'default';
      if (reduce) draw(0);
    };
    canvas.addEventListener('pointermove', pick);
    canvas.addEventListener('pointerdown', pick);
    canvas.addEventListener('pointerleave', () => {
      hover = -1;
      if (reduce) draw(0);
    });

    const clusterColor = (k: number) =>
      k === 0 ? colors.accent : k === 1 ? colors.ink : colors.muted;

    function draw(t: number) {
      ctx.clearRect(0, 0, w, h);
      for (const n of nodes) {
        n.x = n.hx + Math.sin(t * 0.00045 + n.ph) * 0.012;
        n.y = n.hy + Math.cos(t * 0.0004 + n.ph * 1.3) * 0.014;
      }
      const lit = hover >= 0 ? new Set([hover, ...neighbors[hover]]) : null;

      ctx.lineCap = 'round';
      for (const e of edges) {
        const A = nodes[e.a];
        const B = nodes[e.b];
        const on = lit && (e.a === hover || e.b === hover);
        const pulse = 0.65 + 0.35 * Math.sin(t * 0.0012 + e.ph);
        let alpha = (A.k === B.k ? 0.42 : 0.22) * e.w * pulse;
        if (lit && !on) alpha *= 0.3;
        ctx.globalAlpha = on ? 0.95 : alpha;
        ctx.strokeStyle = on ? colors.accent : colors.ink;
        ctx.lineWidth = on ? 1.6 : 0.6 + e.w * 0.9;
        ctx.beginPath();
        ctx.moveTo(A.x * w, A.y * h);
        ctx.lineTo(B.x * w, B.y * h);
        ctx.stroke();
      }

      nodes.forEach((n, i) => {
        const dim = lit && !lit.has(i);
        const r = i === hover ? n.r + 3 : n.r;
        ctx.globalAlpha = dim ? 0.25 : 1;
        ctx.fillStyle = lit && lit.has(i) ? colors.accent : clusterColor(n.k);
        ctx.beginPath();
        ctx.arc(n.x * w, n.y * h, r, 0, Math.PI * 2);
        ctx.fill();
        if (i === hover) {
          ctx.globalAlpha = 0.25;
          ctx.beginPath();
          ctx.arc(n.x * w, n.y * h, r + 8, 0, Math.PI * 2);
          ctx.fill();
        }
      });
      ctx.globalAlpha = 1;
    }

    if (reduce) {
      resize();
      return;
    }
    let visible = true;
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(canvas);
    const loop = (t: number) => {
      if (visible) draw(t);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }

  document.querySelectorAll<HTMLElement>('figure.network').forEach(init);
</script>

<style>
  .network {
    margin: 0;
  }
  canvas {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 0.9;
    touch-action: pan-y;
  }
</style>
