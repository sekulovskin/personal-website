---
import { sections, site } from '../data/site';
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand">
      <svg class="mark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <line x1="5" y1="6" x2="18" y2="8" />
        <line x1="5" y1="6" x2="9" y2="18" />
        <line x1="18" y1="8" x2="9" y2="18" />
        <line x1="18" y1="8" x2="20" y2="19" />
        <circle cx="5" cy="6" r="2.6" />
        <circle cx="18" cy="8" r="2.6" class="hot" />
        <circle cx="9" cy="18" r="2.6" />
        <circle cx="20" cy="19" r="1.8" />
      </svg>
      <span>{site.name}</span>
    </a>

    <nav aria-label="Sections">
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={`/#${s.id}`} data-section={s.id}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="theme-toggle" type="button" aria-label="Switch between light and dark mode">
      <svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5"></circle>
        <path
          d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
      <svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    window.dispatchEvent(new Event('themechange'));
  });

  // Highlight the nav link of the section currently in view (home page only).
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('nav a[data-section]')].map((a) => [
      a.dataset.section!,
      a,
    ]),
  );
  const targets = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  const nav = document.querySelector<HTMLElement>('.site-header nav')!;

  if (targets.length) {
    const visible = new Set<string>();
    // The last section is short and never reaches the band, so the page bottom counts as "in it".
    const atBottom = () => innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
    let wasAtBottom = false;
    addEventListener(
      'scroll',
      () => {
        if (atBottom() !== wasAtBottom) {
          wasAtBottom = !wasAtBottom;
          update();
        }
      },
      { passive: true },
    );
    const update = () => {
      const current = atBottom()
        ? targets[targets.length - 1].id
        : targets.find((t) => visible.has(t.id))?.id;
      links.forEach((a, id) => {
        if (id === current) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      // On phones the link row scrolls sideways; keep the active link in view.
      const active = links.get(current ?? '');
      if (active && nav.scrollWidth > nav.clientWidth) {
        nav.scrollTo({
          left: active.offsetLeft - (nav.clientWidth - active.offsetWidth) / 2,
          behavior: 'smooth',
        });
      }
    };
    // A band just below the header counts as "in view".
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        update();
      },
      { rootMargin: '-80px 0px -65% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--header);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .mark {
    stroke: var(--ink);
    stroke-width: 1.2;
    fill: var(--ink);
  }
  .mark .hot {
    fill: var(--accent);
    stroke: var(--accent);
  }
  nav {
    position: relative;
  }
  ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    position: relative;
    display: block;
    padding: 6px 10px;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 1px;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current] {
    color: var(--ink);
  }
  nav a[aria-current]::after {
    transform: scaleX(1);
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .moon {
    display: none;
  }
  :global([data-theme='dark']) .sun {
    display: none;
  }
  :global([data-theme='dark']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }

  /* On narrow screens the links get their own scrollable row. */
  @media (max-width: 860px) {
    .bar {
      flex-wrap: wrap;
      height: auto;
      padding-top: 10px;
      gap: 4px 16px;
    }
    nav {
      order: 3;
      width: calc(100% + 2 * var(--gutter));
      margin: 0 calc(-1 * var(--gutter));
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav::-webkit-scrollbar {
      display: none;
    }
    ul {
      padding: 0 calc(var(--gutter) - 10px) 4px;
    }
  }
</style>
