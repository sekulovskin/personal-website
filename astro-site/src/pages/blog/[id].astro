---
// Pages for blog posts written in Markdown (src/content/blog/*.md without `href`).
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && !data.href);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base title={post.data.title} description={post.data.summary}>
  <article class="wrap post">
    <a class="back mono" href="/#blog">← Blog</a>
    <h1>{post.data.title}</h1>
    <time class="mono" datetime={post.data.date.toISOString().slice(0, 10)}>{date}</time>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post {
    max-width: 760px;
    padding-top: clamp(40px, 8vw, 88px);
    padding-bottom: 40px;
  }
  .back {
    color: var(--muted);
    text-decoration: none;
  }
  h1 {
    margin: 16px 0 12px;
    font-family: var(--serif);
    font-size: clamp(38px, 6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  time {
    color: var(--faint);
  }
  .prose {
    margin-top: 40px;
    font-size: 17px;
    line-height: 1.75;
  }
  .prose :global(:is(p, ul, ol, pre, blockquote, figure, table)) {
    margin: 0 0 20px;
  }
  .prose :global(:is(h2, h3)) {
    margin: 40px 0 12px;
    font-family: var(--serif);
    letter-spacing: -0.005em;
  }
  .prose :global(h2) {
    font-size: 32px;
  }
  .prose :global(h3) {
    font-size: 25px;
  }
  .prose :global(img) {
    height: auto;
    border-radius: 8px;
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.86em;
  }
  .prose :global(:not(pre) > code) {
    padding: 1px 5px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .prose :global(pre) {
    padding: 16px 18px;
    overflow-x: auto;
    border-radius: 8px;
    border: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.6;
  }
  .prose :global(blockquote) {
    padding-left: 18px;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .prose :global(:is(th, td)) {
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
</style>
