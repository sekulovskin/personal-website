---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import NetworkHero from '../components/NetworkHero.astro';
import Publication from '../components/Publication.astro';
import PostList from '../components/PostList.astro';
import avatar from '../assets/avatar.jpg';
import { Content as Bio } from '../text/bio.md';
import { site } from '../data/site';
import { created, contributed } from '../data/software';
import { talks, workshops } from '../data/talks';
import { byYear, forthcoming } from '../lib/publications';

const scholar = site.links.find((l) => l.label === 'Google Scholar')!;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const month = (ym: string) => `${MONTHS[Number(ym.slice(5, 7)) - 1]} ${ym.slice(0, 4)}`;
---

<Base>
  <section id="about" class="hero wrap">
    <div class="intro">
      <Image class="portrait" src={avatar} alt="Portrait of Nikola Sekulovski" width={192} height={192} quality={85} />
      <h1>{site.name}</h1>
      <p class="role">
        {site.role} · <a href={site.groupUrl}>Psychological Methods</a>, University of Amsterdam
      </p>
      <div class="bio"><Bio /></div>
      <ul class="hero-links">
        <li><a href={`mailto:${site.email}`}>Email</a></li>
        {site.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div class="visual">
      <NetworkHero />
    </div>
  </section>

  <Section id="publications" num={1} title="Publications">
    <p class="lead">
      Each paper links to the journal version and, where there is one, a free preprint. The full list is also on <a
        href={scholar.href}>Google Scholar</a
      >.
    </p>
    {
      forthcoming.length > 0 && (
        <div class="group">
          <h3 class="group-label mono">Forthcoming</h3>
          <ol class="plain">
            {forthcoming.map((p) => (
              <Publication pub={p} />
            ))}
          </ol>
        </div>
      )
    }
    {
      byYear.map(([year, pubs]) => (
        <div class="group">
          <h3 class="group-label mono">{year}</h3>
          <ol class="plain">
            {pubs.map((p) => (
              <Publication pub={p} />
            ))}
          </ol>
        </div>
      ))
    }
  </Section>

  <Section id="software" num={2} title="Software">
    <p class="lead">Most of the methods I work on end up in an R package or in JASP.</p>
    {
      [
        { label: 'R packages I maintain', items: created },
        { label: 'Software I contribute to', items: contributed },
      ].map((g) => (
        <div class="group">
          <h3 class="group-label mono">{g.label}</h3>
          <ul class="plain">
            {g.items.map((s) => (
              <li class="row software">
                <div>
                  <h4 class="name">{s.name}</h4>
                  <p>{s.description}</p>
                  {s.note && <p class="note">{s.note}</p>}
                </div>
                <div class="chips">
                  {s.links.map((l) => (
                    <a class="chip" href={l.href}>
                      {l.label}
                      <span class="arrow">↗</span>
                    </a>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </Section>

  <Section id="talks" num={3} title="Talks & workshops">
    <div class="group">
      <h3 class="group-label mono">Talks</h3>
      <ul class="plain">
        {
          talks.map((t) => (
            <li class="row dated">
              <span class="when mono">{month(t.date)}</span>
              <div>
                <h4>{t.url ? <a href={t.url}>{t.title}</a> : t.title}</h4>
                <p>
                  {t.event} · {t.place}
                </p>
              </div>
              <span class:list={['kind', 'mono', t.kind.toLowerCase()]}>{t.kind}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="group">
      <h3 class="group-label mono">Workshops I taught or assisted with</h3>
      <ul class="plain">
        {
          workshops.map((w) => (
            <li class="row dated">
              <span class="when mono">{w.when}</span>
              <div>
                <h4>{w.url ? <a href={w.url}>{w.title}</a> : w.title}</h4>
                <p>
                  {w.event}
                  {w.role && <span class="role-note"> · {w.role}</span>}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="blog" num={4} title="Blog">
    <p class="lead">Tutorials for some of my papers, and the occasional post.</p>
    <PostList />
  </Section>

  <Section id="contact" num={5} title="Contact">
    <p class="lead">Email is the easiest way to reach me.</p>
    <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    <p class="address">
      Psychological Methods, Department of Psychology<br />
      University of Amsterdam, the Netherlands
    </p>
    <ul class="hero-links">
      {site.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </Section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
    padding-top: clamp(40px, 7vw, 88px);
    padding-bottom: 0;
  }
  .intro > * {
    animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .intro > :nth-child(2) {
    animation-delay: 60ms;
  }
  .intro > :nth-child(3) {
    animation-delay: 120ms;
  }
  .intro > :nth-child(n + 4) {
    animation-delay: 180ms;
  }
  .visual {
    animation: fade 1.4s ease 250ms both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .portrait {
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: 50%;
    margin-bottom: 28px;
    border: 1px solid var(--line);
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(48px, 7.5vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .role {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
  }
  .bio {
    margin-top: 28px;
    max-width: 58ch;
    font-size: 17px;
    line-height: 1.7;
    text-align: justify;
    hyphens: auto;
    /* Only split words of 7+ letters, keeping at least 3 letters on each side. */
    hyphenate-limit-chars: 7 3 3;
  }
  .bio :global(p + p) {
    margin-top: 14px;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-size: 13px;
  }
  .hero-links a {
    color: var(--muted);
    text-decoration: none;
  }
  .hero-links a::after {
    content: ' ↗';
    font-size: 10px;
    opacity: 0.6;
  }
  .hero-links a[href^='mailto']::after {
    content: '';
  }
  .hero-links a:hover {
    color: var(--accent);
  }

  /* ---------- shared bits inside sections ---------- */
  .lead {
    margin-bottom: 28px;
    color: var(--muted);
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .group + .group {
    margin-top: 40px;
  }
  .group-label {
    margin-bottom: 4px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
  }
  .row {
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .row h4,
  .name {
    margin: 0;
    font-size: 16px;
    font-weight: 560;
    line-height: 1.45;
  }
  .row h4 a {
    text-decoration: none;
  }
  .row h4 a:hover {
    text-decoration: underline;
  }
  .row p {
    margin-top: 2px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .note {
    font-style: italic;
  }

  /* ---------- software ---------- */
  .software {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px 24px;
    align-items: start;
  }
  .software .name {
    font-family: var(--mono);
    font-size: 15px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
    padding-top: 2px;
  }

  /* ---------- talks ---------- */
  .dated {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr) auto;
    gap: 16px;
    align-items: start;
  }
  .when {
    padding-top: 3px;
    color: var(--faint);
  }
  .kind {
    padding: 0 7px;
    margin-top: 2px;
    font-size: 11px;
    line-height: 19px;
    border-radius: 4px;
    color: var(--muted);
    border: 1px solid var(--line);
  }
  .kind.invited {
    color: var(--accent);
    border-color: transparent;
    background: var(--accent-soft);
  }

  /* ---------- contact ---------- */
  .email {
    display: inline-block;
    font-family: var(--serif);
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
  }
  .address {
    margin-top: 20px;
    font-size: 14.5px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .visual {
      max-width: 420px;
      width: 100%;
      margin: 0 auto;
    }
  }
  @media (max-width: 560px) {
    /* Phone lines are too short to justify without large gaps. */
    .bio {
      text-align: left;
      hyphens: manual;
    }
    .software {
      grid-template-columns: minmax(0, 1fr);
    }
    .chips {
      justify-content: flex-start;
    }
    .dated {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2px 12px;
    }
    .when {
      grid-column: 1 / -1;
      padding-top: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro > *,
    .visual {
      animation: none;
    }
  }
</style>
